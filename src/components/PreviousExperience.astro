---
import HeadingDecorator from "./HeadingDecorator.astro";
import IrisIcon from "./icons/IrisIcon.astro";
import KpmgIcon from "./icons/KpmgIcon.astro";
import JobDetails from "./JobDetails.astro";
---

<section {...Astro.props}>
  <h2 class="text-2xl font-bold mb-4">
    <HeadingDecorator /> Previous experience
  </h2>
  <ul class="space-y-8">
    <li>
      <JobDetails
        company="KPMG"
        role="Lead front end developer"
        startDate="Nov 2015"
        endDate="Jul 2019"
        technologies="React, Redux, Redux-Saga, D3, Webpack, Jest, Enzyme, Styled-Components, .NET Core, Microservices, AWS, Jenkins, Docker, Identity Server, Entity Framework"
      >
        <KpmgIcon slot="icon" />
        <div class="space-y-4">
          <p>
            Worked across deal advisory, audit, and financial crime technology.
            Selected projects:
          </p>
          <ul class="list-disc list-inside space-y-4">
            <li>
              Audit Tools Suite: Built custom D3 and SVG visualizations to
              support predictive analytics for audit processes.
            </li>
            <li>
              Sanctions Screening Testing Platform: Applied test-driven
              development and led design reviews for financial crime testing
              tools.
            </li>
            <li>
              DealTech: Developed a high-load microservices platform for deal
              advisory, with shared authentication, queues, and notifications.
            </li>
          </ul>

          <p>
            Responsibilities included technical delivery, front-end and back-end
            architecture, CI/CD, team mentoring, and recruitment support.
          </p>
        </div>
      </JobDetails>
    </li>
    <li>
      <JobDetails
        company="IRIS"
        role="Senior software engineer"
        startDate="Mar 2013"
        endDate="Nov 2015"
        technologies="Knockout, Bootstrap, SASS, jQuery, jQueryUI, Azure, ASP .NET MVC 4, Ninject, Entity Framework, SQL Server"
      >
        <IrisIcon slot="icon" />
        <div class="space-y-4">
          <p>
            Contributed to the design and development of payroll web
            applications, including Kashflow Payroll and IRIS OpenPayslips. Key
            achievements included delivering the acclaimed automatic enrolment
            module, improving application performance, and modernising the
            front-end codebase by migrating CSS to Sass.
          </p>

          <i class="text-muted text-sm"
            >Awarded Employee of the Month, Jan 2015</i
          >
        </div>
      </JobDetails>
    </li>
  </ul>
</section>
